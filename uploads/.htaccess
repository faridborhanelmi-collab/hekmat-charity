# ─── Hekmat Charity: Upload Directory Security Hardening ───
# Prevent execution of any scripts in the uploads directory

Options -Indexes -ExecCGI

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Block access to any executable or script extensions
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|pht|phar|inc|cgi|pl|py|sh|bash|exe|bat|cmd|env|sql|sqlite|db)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Force correct MIME types and prevent MIME sniffing
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
